<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <GCLatencyLevel>Interactive</GCLatencyLevel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
        <PackageReference Include="ElectronNET.API" Version="23.6.2" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
        <PackageReference Include="SharpHook" Version="7.1.3" />
    </ItemGroup>

    <!-- GESTIONE CORRETTA DEI FILE STATICI E PRELOAD.JS -->
    <ItemGroup>
        <Content Update="electron.manifest.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <!-- Forza la copia continua e costante di preload.js in output e nella publish -->
        <Content Include="preload.js">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <!-- Aggiorna i file statici di wwwroot già implicitamente tracciati dall'SDK Web -->
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\YTMusicSharp\YTMusicSharp.csproj" />
    </ItemGroup>

    <!-- PULIZIA AUTOMATICA DELLA CACHE DI ELECTRON.NET PRIMA DELLA BUILD -->
    <Target Name="CleanElectronBuildCache" BeforeTargets="BeforeBuild;Publish">
        <RemoveDir Directories="$(BaseIntermediateOutputPath)desktop" />
    </Target>

</Project>
